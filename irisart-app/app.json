{
  "expo": {
    "name": "IrisArt",
    "slug": "irisart-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "irisartapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#05060A"
    },
    "locales": {
      "en": "./locales/en.json",
      "de": "./locales/de.json"
    },
    "ios": {
      "bundleIdentifier": "app.irisart.mobile",
      "buildNumber": "4",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleDevelopmentRegion": "en",
        "NSCameraUsageDescription": "IrisArt uses the camera for close-up photos of your iris for color analysis and art generation.",
        "NSPhotoLibraryUsageDescription": "IrisArt accesses your photo library so you can choose a close-up photo of your iris.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.irisart.mobile",
      "versionCode": 4,
      "permissions": [
        "CAMERA",
        "FLASHLIGHT"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#05060A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "staticRendering": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "IrisArt uses the camera for close-up photos of your iris for color analysis and art generation.",
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "amir.fgt",
    "extra": {
      "eas": {
        "projectId": "3ff17c55-378a-4e72-9bca-2f610a793b94"
      }
    }
  }
}

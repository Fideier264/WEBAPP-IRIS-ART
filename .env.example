# Kopiere diese Datei nach .env im Projektroot und trage echte Werte ein.
# .env wird von Git ignoriert — niemals Secrets committen.

# Supabase (öffentlich in der App — Anon Key ist client-seitig)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Öffentliche App-URL (für Stripe Success/Cancel Redirects; auf Web oft auto aus window.location)
EXPO_PUBLIC_APP_ORIGIN=https://your-domain.example

# merchOne Blueprint-SKUs (öffentlich, aus dem merchOne-Dashboard)
EXPO_PUBLIC_MERCHONE_SKU_CANVAS_30CM=
EXPO_PUBLIC_MERCHONE_SKU_CANVAS_60CM=

# Empfohlen: Produktkatalog als JSON (Foto-Karten; title = Anzeigename, z. B. Größe)
# EXPO_PUBLIC_MERCHONE_CATALOG=[{"sku":"SKU30","title":"30 × 30 cm","category":"canvas","categoryLabel":"Leinwand","priceEur":49.9,"imageUrl":"https://…/optional-product.jpg"}]

# Anzeige-Preise für Legacy-SKUs (wenn kein CATALOG gesetzt)
EXPO_PUBLIC_PRICE_EUR_30CM=49.90
EXPO_PUBLIC_PRICE_EUR_60CM=89.90

# Nur für lokale Supabase-CLI / Dokumentation — echte Secrets gehören in
# Supabase Dashboard → Edge Functions → Secrets (nicht in Git):
# REPLICATE_API_TOKEN=
# NANO_BANANA_2_API_KEY=
# MERCHONE_API_USER=
# MERCHONE_API_KEY=
# MERCHONE_SKU_CANVAS_30CM=   # gleiche Werte wie EXPO_PUBLIC_… (für Stripe-Preis-Mapping)
# MERCHONE_SKU_CANVAS_60CM=
# STRIPE_SECRET_KEY=sk_test_…
# STRIPE_WEBHOOK_SECRET=whsec_…
# STRIPE_AMOUNT_CENTS_30CM=4990
# STRIPE_AMOUNT_CENTS_60CM=8990
# STRIPE_CURRENCY=eur
# APP_ORIGIN=https://your-domain.example
# CHECKOUT_ALLOWED_ORIGINS=https://your-domain.example,http://localhost:8081
# SUPABASE_SERVICE_ROLE_KEY=
